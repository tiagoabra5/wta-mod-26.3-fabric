			"com.tiago.WtaMod"
		],
		"client": [
			"com.tiago.client.WtaModClient"
		]
	},
	"mixins": [
		{
			"config": "wta-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
