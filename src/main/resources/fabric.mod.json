{
	"schemaVersion": 1,
	"id": "wta-mod",
	"version": "${version}",
	"name": "WTA — Where They Are",
	"description": "Shows each player's dimension beside their head in the TAB player list.",
	"authors": [
		"Tiago"
	],
	"license": "CC0-1.0",
	"icon": "assets/wta-mod/icon.png",
	"environment": "*",
	"entrypoints": {
